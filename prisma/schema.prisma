generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  TENANT
  LANDLORD
  AGENT
  ADMIN
}

enum VerificationStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  FAILED
}

enum IdDocumentType {
  NATIONAL_ID
  VOTERS_CARD
  PASSPORT
  DRIVERS_LICENCE
}

enum BadgeTier {
  NONE
  ID_VERIFIED
  PROPERTY_VERIFIED
  CERTIFIED
}

enum AgentPlan {
  NONE
  BASIC
  PRO
  ENTERPRISE
}

enum OtpType {
  PHONE_VERIFY
  EMAIL_VERIFY
  LOGIN
  SENSITIVE_ACTION
}

model User {
  id                     String             @id @default(cuid())
  email                  String?            @unique
  phone                  String?            @unique
  passwordHash           String?
  role                   UserRole           @default(TENANT)
  isEmailVerified        Boolean            @default(false)
  isPhoneVerified        Boolean            @default(false)
  bvnHash                String?
  bvnVerificationStatus  VerificationStatus @default(NOT_SUBMITTED)
  ninHash                String?
  ninVerificationStatus  VerificationStatus @default(NOT_SUBMITTED)
  idDocumentStatus       VerificationStatus @default(NOT_SUBMITTED)
  trustScore             Int                @default(0)
  firstName              String?
  lastName               String?
  dateOfBirth            DateTime?
  profilePhoto           String?
  isActive               Boolean            @default(true)
  isBanned               Boolean            @default(false)
  onboardingComplete     Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  accounts              Account[]
  sessions              Session[]
  profile               UserProfile?
  landlordVerification  LandlordVerification?
  agentProfile          AgentProfile?
  ownedListings         Listing[]    @relation("OwnedListings")
  agentListings         Listing[]    @relation("AgentListings")
  savedListings         SavedListing[]
  enquiries             Enquiry[]

  @@map("users")
}

model UserProfile {
  id                    String          @id @default(cuid())
  userId                String          @unique
  employmentStatus      String?
  employerName          String?
  bankStatementUploaded Boolean         @default(false)
  payslipUploaded       Boolean         @default(false)
  selfieUrl             String?
  governmentIdUrl       String?
  governmentIdType      IdDocumentType?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model LandlordVerification {
  id                    String    @id @default(cuid())
  userId                String    @unique
  badgeTier             BadgeTier @default(NONE)
  titleDocumentUrl      String?
  utilityBillUrl        String?
  completedTransactions Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("landlord_verifications")
}

model AgentProfile {
  id                        String             @id @default(cuid())
  userId                    String             @unique
  businessName              String?
  cacNumber                 String?
  cacVerificationStatus     VerificationStatus @default(NOT_SUBMITTED)
  lasreraNumber             String?
  lasreraVerificationStatus VerificationStatus @default(NOT_SUBMITTED)
  subscriptionPlan          AgentPlan          @default(NONE)
  subscriptionExpiresAt     DateTime?
  bio                       String?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("agent_profiles")
}

model OtpCode {
  id         String   @id @default(cuid())
  identifier String
  code       String
  type       OtpType
  expiresAt  DateTime
  used       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([identifier, type])
  @@map("otp_codes")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum PropertyType {
  FLAT
  SELF_CONTAINED
  DUPLEX
  BUNGALOW
  TERRACED_HOUSE
  DETACHED_HOUSE
  ROOM_AND_PARLOUR
  STUDIO
}

enum FurnishingStatus {
  UNFURNISHED
  SEMI_FURNISHED
  FULLY_FURNISHED
}

enum LetType {
  LONG_LET
  SHORT_LET
}

enum PaymentFrequency {
  ANNUAL
  BIANNUAL
  QUARTERLY
  MONTHLY
}

enum ListingStatus {
  DRAFT
  PENDING_VERIFICATION
  VERIFIED_ACTIVE
  UNVERIFIED_ACTIVE
  PAUSED
  LET_AGREED
  OCCUPIED
  EXPIRED
}

enum PropertyCondition {
  NEW
  GOOD
  NEEDS_MINOR_WORK
}

model Listing {
  id          String        @id @default(cuid())
  title       String
  description String?       @db.Text
  slug        String        @unique

  // Ownership
  ownerId     String
  owner       User          @relation("OwnedListings", fields: [ownerId], references: [id])
  agentId     String?
  agent       User?         @relation("AgentListings", fields: [agentId], references: [id])

  // Type & basics
  propertyType      PropertyType
  bedrooms          Int
  bathrooms         Int
  toilets           Int
  floorLevel        Int?
  furnishingStatus  FurnishingStatus  @default(UNFURNISHED)
  letType           LetType           @default(LONG_LET)
  propertyCondition PropertyCondition @default(GOOD)
  yearBuilt         Int?
  availableFrom     DateTime

  // Location
  address                  String
  area                     String
  lga                      String
  state                    String
  latitude                 Float?
  longitude                Float?
  landmark                 String?
  neighbourhoodDescription String?

  // Pricing
  annualRent         BigInt
  cautionDeposit     BigInt?
  serviceCharge      BigInt?
  agencyFee          BigInt?
  paymentFrequencies PaymentFrequency[]

  // Status
  status       ListingStatus @default(DRAFT)
  isVerified   Boolean       @default(false)
  viewCount    Int           @default(0)
  enquiryCount Int           @default(0)

  // Media
  photos         ListingPhoto[]
  videoUrl       String?
  virtualTourUrl String?

  // Amenities (stored as string array)
  amenities String[]

  // Documents
  titleDocumentUrl String?
  surveyPlanUrl    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expiresAt DateTime?

  savedBy   SavedListing[]
  enquiries Enquiry[]

  @@index([state, lga])
  @@index([status])
  @@index([ownerId])
  @@map("listings")
}

model ListingPhoto {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@map("listing_photos")
}

model SavedListing {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@map("saved_listings")
}

model Enquiry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id])
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@map("enquiries")
}
