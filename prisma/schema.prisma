generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  TENANT
  LANDLORD
  AGENT
  ADMIN
  DEVELOPER
}

enum VerificationStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  FAILED
}

enum IdDocumentType {
  NATIONAL_ID
  VOTERS_CARD
  PASSPORT
  DRIVERS_LICENCE
}

enum BadgeTier {
  NONE
  ID_VERIFIED
  PROPERTY_VERIFIED
  CERTIFIED
}

enum AgentPlan {
  NONE
  BASIC
  PRO
  ENTERPRISE
}

enum OtpType {
  PHONE_VERIFY
  EMAIL_VERIFY
  LOGIN
  SENSITIVE_ACTION
}

model User {
  id                     String             @id @default(cuid())
  email                  String?            @unique
  phone                  String?            @unique
  passwordHash           String?
  role                   UserRole           @default(TENANT)
  isEmailVerified        Boolean            @default(false)
  isPhoneVerified        Boolean            @default(false)
  emailVerificationToken String?            @unique
  emailVerificationTokenExpiry DateTime?
  bvnHash                String?
  bvnVerificationStatus  VerificationStatus @default(NOT_SUBMITTED)
  ninHash                String?
  ninVerificationStatus  VerificationStatus @default(NOT_SUBMITTED)
  idDocumentStatus       VerificationStatus @default(NOT_SUBMITTED)
  trustScore             Int                @default(0)
  firstName              String?
  lastName               String?
  dateOfBirth            DateTime?
  profilePhoto           String?
  isActive               Boolean            @default(true)
  isBanned               Boolean            @default(false)
  onboardingComplete     Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  accounts              Account[]
  sessions              Session[]
  profile               UserProfile?
  landlordVerification  LandlordVerification?
  agentProfile          AgentProfile?
  ownedListings         Listing[]    @relation("OwnedListings")
  agentListings         Listing[]    @relation("AgentListings")
  savedListings         SavedListing[]
  enquiries             Enquiry[]
  tenantTransactions    EscrowTransaction[] @relation("TenantTransactions")
  landlordTransactions  EscrowTransaction[] @relation("LandlordTransactions")
  tenantViewings        ViewingBooking[]    @relation("TenantViewings")
  raisedDisputes        Dispute[]           @relation("RaisedDisputes")
  tenantConversations   Conversation[]      @relation("TenantConversations")
  ownerConversations    Conversation[]      @relation("OwnerConversations")
  sentMessages          Message[]           @relation("SentMessages")
  tenantMaintenance     MaintenanceRequest[] @relation("TenantMaintenance")
  landlordMaintenance   MaintenanceRequest[] @relation("LandlordMaintenance")
  tenantRentPayments    RentPayment[]        @relation("TenantRentPayments")
  landlordInspections   PropertyInspection[] @relation("LandlordInspections")
  landlordRenewals      LeaseRenewal[]       @relation("LandlordRenewals")
  tenantRenewals        LeaseRenewal[]       @relation("TenantRenewals")
  tenantInstallments    InstallmentPlan[]    @relation("TenantInstallments")
  tenantInstallmentPayments Installment[]    @relation("TenantInstallmentPayments")
  agentCRMContacts      CRMContact[]         @relation("AgentCRMContacts")
  agentCommissions      AgentCommission[]    @relation("AgentCommissions")
  givenReviews          Review[]             @relation("GivenReviews")
  receivedReviews       Review[]             @relation("ReceivedReviews")
  notifications         Notification[]
  developerProfile      DeveloperProfile?

  // Diaspora fields
  preferredCurrency     String   @default("NGN")
  isDiaspora            Boolean  @default(false)
  countryOfResidence    String?

  @@map("users")
}

model UserProfile {
  id                    String          @id @default(cuid())
  userId                String          @unique
  employmentStatus      String?
  employerName          String?
  bankStatementUploaded Boolean         @default(false)
  payslipUploaded       Boolean         @default(false)
  selfieUrl             String?
  governmentIdUrl       String?
  governmentIdType      IdDocumentType?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model LandlordVerification {
  id                    String    @id @default(cuid())
  userId                String    @unique
  badgeTier             BadgeTier @default(NONE)
  titleDocumentUrl      String?
  utilityBillUrl        String?
  completedTransactions Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("landlord_verifications")
}

model AgentProfile {
  id                        String             @id @default(cuid())
  userId                    String             @unique
  businessName              String?
  cacNumber                 String?
  cacVerificationStatus     VerificationStatus @default(NOT_SUBMITTED)
  lasreraNumber             String?
  lasreraVerificationStatus VerificationStatus @default(NOT_SUBMITTED)
  subscriptionPlan          AgentPlan          @default(NONE)
  subscriptionExpiresAt     DateTime?
  bio                       String?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("agent_profiles")
}

model OtpCode {
  id         String   @id @default(cuid())
  identifier String
  code       String
  type       OtpType
  expiresAt  DateTime
  used       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([identifier, type])
  @@map("otp_codes")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum PropertyType {
  FLAT
  SELF_CONTAINED
  DUPLEX
  BUNGALOW
  TERRACED_HOUSE
  DETACHED_HOUSE
  ROOM_AND_PARLOUR
  STUDIO
}

enum FurnishingStatus {
  UNFURNISHED
  SEMI_FURNISHED
  FULLY_FURNISHED
}

enum LetType {
  LONG_LET
  SHORT_LET
}

enum PaymentFrequency {
  ANNUAL
  BIANNUAL
  QUARTERLY
  MONTHLY
}

enum ListingStatus {
  DRAFT
  PENDING_VERIFICATION
  VERIFIED_ACTIVE
  UNVERIFIED_ACTIVE
  PAUSED
  LET_AGREED
  OCCUPIED
  EXPIRED
}

enum PropertyCondition {
  NEW
  GOOD
  NEEDS_MINOR_WORK
}

model Listing {
  id          String        @id @default(cuid())
  title       String
  description String?       @db.Text
  slug        String        @unique

  // Ownership
  ownerId     String
  owner       User          @relation("OwnedListings", fields: [ownerId], references: [id])
  agentId     String?
  agent       User?         @relation("AgentListings", fields: [agentId], references: [id])

  // Type & basics
  propertyType      PropertyType
  bedrooms          Int
  bathrooms         Int
  toilets           Int
  floorLevel        Int?
  furnishingStatus  FurnishingStatus  @default(UNFURNISHED)
  letType           LetType           @default(LONG_LET)
  propertyCondition PropertyCondition @default(GOOD)
  yearBuilt         Int?
  availableFrom     DateTime

  // Location
  address                  String
  area                     String
  lga                      String
  state                    String
  latitude                 Float?
  longitude                Float?
  landmark                 String?
  neighbourhoodDescription String?

  // Pricing
  annualRent         BigInt
  cautionDeposit     BigInt?
  serviceCharge      BigInt?
  agencyFee          BigInt?
  paymentFrequencies PaymentFrequency[]

  // Status
  status          ListingStatus @default(DRAFT)
  isVerified      Boolean       @default(false)
  isDiasporaReady Boolean       @default(false)
  viewCount    Int           @default(0)
  enquiryCount Int           @default(0)

  // Media
  photos         ListingPhoto[]
  videoUrl       String?
  virtualTourUrl String?

  // Amenities (stored as string array)
  amenities String[]

  // Documents
  titleDocumentUrl String?
  surveyPlanUrl    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expiresAt DateTime?

  savedBy       SavedListing[]
  enquiries     Enquiry[]
  transactions  EscrowTransaction[]
  viewings      ViewingBooking[]
  conversations Conversation[]

  @@index([state, lga])
  @@index([status])
  @@index([ownerId])
  @@map("listings")
}

model ListingPhoto {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@map("listing_photos")
}

model SavedListing {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@map("saved_listings")
}

model Enquiry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id])
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@map("enquiries")
}

enum EscrowStatus {
  PENDING_PAYMENT
  FUNDED
  RELEASED
  REFUNDED
  DISPUTED
}

enum TransactionType {
  ESCROW_PAYMENT
  PAYOUT
  REFUND
  CAUTION_DEPOSIT
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  USSD
}

enum DisputeStatus {
  OPEN
  EVIDENCE_COLLECTION
  MEDIATION
  ADJUDICATION
  RESOLVED
  ESCALATED
}

enum DisputeCategory {
  NOT_AS_DESCRIBED
  NOT_ACCESSIBLE
  MAJOR_DEFECT
  CAUTION_DEPOSIT
  FRAUDULENT_LISTING
}

enum DisputeOutcome {
  FULL_REFUND_TENANT
  PARTIAL_REFUND
  FULL_RELEASE_LANDLORD
  SPLIT
}

enum ViewingStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum MoveInStatus {
  SCHEDULED
  CONFIRMED
  DISPUTED
}

enum MaintenanceStatus {
  SUBMITTED
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  DECLINED
}

enum MaintenanceCategory {
  PLUMBING
  ELECTRICAL
  STRUCTURAL
  APPLIANCE
  SECURITY
  PEST_CONTROL
  CLEANING
  OTHER
}

enum InspectionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum InstallmentStatus {
  PENDING
  PAID
  FAILED
  OVERDUE
}

enum CRMContactType {
  LANDLORD_CLIENT
  TENANT_LEAD
}

enum LeadStatus {
  NEW
  VIEWING_BOOKED
  OFFER_MADE
  LET_AGREED
  LOST
}

enum NotificationType {
  NEW_LISTING_MATCH
  VIEWING_CONFIRMED
  VIEWING_REMINDER
  ESCROW_FUNDED
  AGREEMENT_SIGNATURE
  MOVE_IN_CONFIRMED
  PAYOUT_SENT
  DISPUTE_RAISED
  DISPUTE_RESOLVED
  LEASE_RENEWAL_REMINDER
  LISTING_EXPIRY
  NEW_APPLICANT
  MAINTENANCE_UPDATE
  RENT_DUE
  INSTALLMENT_DUE
  SYSTEM
}

model EscrowTransaction {
  id          String @id @default(cuid())
  reference   String @unique
  listingId   String
  listing     Listing @relation(fields: [listingId], references: [id])
  tenantId    String
  tenant      User    @relation("TenantTransactions", fields: [tenantId], references: [id])
  landlordId  String
  landlord    User    @relation("LandlordTransactions", fields: [landlordId], references: [id])

  rentAmount    BigInt
  cautionAmount BigInt @default(0)
  safeRentFee   BigInt
  documentFee   BigInt @default(800000)
  totalAmount   BigInt

  paymentMethod  PaymentMethod
  escrowStatus   EscrowStatus  @default(PENDING_PAYMENT)

  paymentDate       DateTime?
  moveInDate        DateTime
  moveInConfirmedAt DateTime?
  escrowReleasedAt  DateTime?
  autoReleaseAt     DateTime?

  payoutSentAt    DateTime?
  payoutReference String?

  tenancyStartDate DateTime?
  tenancyEndDate   DateTime?

  agreement   TenancyAgreement?
  dispute     Dispute?
  moveInRecord MoveInRecord?
  maintenanceRequests MaintenanceRequest[]
  rentPayments RentPayment[]
  inspections  PropertyInspection[]
  renewal      LeaseRenewal?
  installmentPlan InstallmentPlan?
  agentCommission AgentCommission?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([landlordId])
  @@index([listingId])
  @@map("escrow_transactions")
}

model MaintenanceRequest {
  id              String              @id @default(cuid())
  tenancyId       String
  tenancy         EscrowTransaction   @relation(fields: [tenancyId], references: [id])
  tenantId        String
  tenant          User                @relation("TenantMaintenance", fields: [tenantId], references: [id])
  landlordId      String
  landlord        User                @relation("LandlordMaintenance", fields: [landlordId], references: [id])

  category        MaintenanceCategory
  title           String
  description     String              @db.Text
  photoUrls       String[]
  urgency         String              @default("normal")

  status          MaintenanceStatus   @default(SUBMITTED)
  landlordNotes   String?             @db.Text
  scheduledDate   DateTime?
  resolvedAt      DateTime?
  tenantConfirmed Boolean             @default(false)

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([tenancyId])
  @@map("maintenance_requests")
}

model RentPayment {
  id              String   @id @default(cuid())
  tenancyId       String
  tenancy         EscrowTransaction @relation(fields: [tenancyId], references: [id])
  tenantId        String
  tenant          User     @relation("TenantRentPayments", fields: [tenantId], references: [id])

  dueDate         DateTime
  amount          BigInt
  paidAt          DateTime?
  paidAmount      BigInt?
  lateFee         BigInt?
  status          String   @default("pending")

  paymentMethod   String?
  reference       String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenancyId])
  @@map("rent_payments")
}

model PropertyInspection {
  id              String          @id @default(cuid())
  tenancyId       String
  tenancy         EscrowTransaction @relation(fields: [tenancyId], references: [id])
  landlordId      String
  landlord        User            @relation("LandlordInspections", fields: [landlordId], references: [id])

  scheduledDate   DateTime
  status          InspectionStatus @default(SCHEDULED)
  noticeGivenAt   DateTime
  notes           String?         @db.Text
  photoUrls       String[]
  reportData      Json?

  completedAt     DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("property_inspections")
}

model LeaseRenewal {
  id              String   @id @default(cuid())
  tenancyId       String   @unique
  tenancy         EscrowTransaction @relation(fields: [tenancyId], references: [id])
  landlordId      String
  landlord        User     @relation("LandlordRenewals", fields: [landlordId], references: [id])
  tenantId        String
  tenant          User     @relation("TenantRenewals", fields: [tenantId], references: [id])

  proposedRent    BigInt
  currentRent     BigInt
  renewalStartDate DateTime
  renewalEndDate   DateTime

  status          String   @default("proposed")
  tenantCounter   BigInt?
  landlordResponse String? @db.Text
  tenantResponse   String? @db.Text

  noticeToVacateAt DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("lease_renewals")
}

model InstallmentPlan {
  id              String   @id @default(cuid())
  transactionId   String   @unique
  transaction     EscrowTransaction @relation(fields: [transactionId], references: [id])
  tenantId        String
  tenant          User     @relation("TenantInstallments", fields: [tenantId], references: [id])

  totalAmount     BigInt
  monthlyAmount   BigInt
  interestRate    Float
  totalInterest   BigInt
  totalRepayable  BigInt

  debitDay        Int
  startDate       DateTime

  status          String   @default("active")
  missedPayments  Int      @default(0)

  installments    Installment[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("installment_plans")
}

model Installment {
  id                String            @id @default(cuid())
  planId            String
  plan              InstallmentPlan   @relation(fields: [planId], references: [id])
  tenantId          String
  tenant            User              @relation("TenantInstallmentPayments", fields: [tenantId], references: [id])

  installmentNumber Int
  dueDate           DateTime
  amount            BigInt
  paidAt            DateTime?
  paidAmount        BigInt?
  status            InstallmentStatus @default(PENDING)
  reference         String?
  retryCount        Int               @default(0)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("installments")
}

model CRMContact {
  id          String          @id @default(cuid())
  agentId     String
  agent       User            @relation("AgentCRMContacts", fields: [agentId], references: [id])

  type        CRMContactType
  firstName   String
  lastName    String
  email       String?
  phone       String?
  notes       String?         @db.Text
  tags        String[]

  leadStatus  LeadStatus?     @default(NEW)
  listingId   String?
  budget      BigInt?
  preferredAreas String[]

  portfolioSize Int?
  activeListings Int?

  followUpDate  DateTime?
  lastContactedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([agentId])
  @@map("crm_contacts")
}

model AgentCommission {
  id              String   @id @default(cuid())
  agentId         String
  agent           User     @relation("AgentCommissions", fields: [agentId], references: [id])
  transactionId   String   @unique
  transaction     EscrowTransaction @relation(fields: [transactionId], references: [id])

  amount          BigInt
  percentage      Float    @default(10.0)
  status          String   @default("pending")
  paidAt          DateTime?
  invoiceNumber   String?

  splitWith       String?
  splitPercentage Float?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("agent_commissions")
}

model Review {
  id          String   @id @default(cuid())
  reviewerId  String
  reviewer    User     @relation("GivenReviews", fields: [reviewerId], references: [id])
  revieweeId  String
  reviewee    User     @relation("ReceivedReviews", fields: [revieweeId], references: [id])
  transactionId String?

  type        String

  overallRating       Int
  conditionRating     Int?
  responsivenessRating Int?
  accuracyRating      Int?
  valueRating         Int?
  paymentRating       Int?
  careRating          Int?

  comment     String?  @db.Text
  response    String?  @db.Text

  isPublished Boolean  @default(true)
  isFlagged   Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([revieweeId])
  @@map("reviews")
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        NotificationType
  title       String
  body        String
  actionUrl   String?
  isRead      Boolean          @default(false)
  readAt      DateTime?

  metadata    Json?

  createdAt   DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

model TenancyAgreement {
  id            String @id @default(cuid())
  transactionId String @unique
  transaction   EscrowTransaction @relation(fields: [transactionId], references: [id])

  tenantLegalName   String
  landlordLegalName String
  tenantAddress     String
  landlordAddress   String

  propertyAddress   String
  tenancyStartDate  DateTime
  tenancyEndDate    DateTime
  rentAmount        BigInt
  paymentFrequency  PaymentFrequency
  cautionDeposit    BigInt
  latePaymentPenalty Int @default(5)
  noticePeriodDays   Int @default(30)

  state String

  tenantSignedAt      DateTime?
  tenantOtpVerified   Boolean @default(false)
  landlordSignedAt    DateTime?
  landlordOtpVerified Boolean @default(false)

  pdfUrl    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tenancy_agreements")
}

model MoveInRecord {
  id            String @id @default(cuid())
  transactionId String @unique
  transaction   EscrowTransaction @relation(fields: [transactionId], references: [id])

  scheduledDate DateTime
  status        MoveInStatus @default(SCHEDULED)
  confirmedAt   DateTime?
  tenantLatitude  Float?
  tenantLongitude Float?
  photoUrl        String?

  conditionReportComplete Boolean @default(false)
  conditionReportData     Json?

  keysHandedOver Boolean @default(false)
  keyDetails     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("move_in_records")
}

model ViewingBooking {
  id        String @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id])
  tenantId  String
  tenant    User    @relation("TenantViewings", fields: [tenantId], references: [id])

  proposedSlots Json
  confirmedSlot DateTime?
  status        ViewingStatus @default(REQUESTED)
  isVirtual     Boolean       @default(false)
  videoCallUrl  String?

  notes          String? @db.Text
  tenantFeedback String?
  tenantNotes    String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listingId])
  @@index([tenantId])
  @@map("viewing_bookings")
}

model DeveloperProfile {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName      String
  cacNumber        String?
  rcNumber         String?
  address          String?
  website          String?
  description      String?   @db.Text
  logoUrl          String?

  totalUnits       Int       @default(0)
  accountManagerId String?

  subscriptionTier String    @default("enterprise")
  contractStart    DateTime?
  contractEnd      DateTime?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("developer_profiles")
}

model ConciergeBooking {
  id                String   @id @default(cuid())
  userId            String
  listingId         String?
  listingUrl        String?
  inspectionDateFrom DateTime?
  inspectionDateTo  DateTime?
  whatsappNumber    String
  message           String?  @db.Text
  status            String   @default("pending")
  fee               BigInt   @default(5000000)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("concierge_bookings")
}

model Dispute {
  id            String @id @default(cuid())
  transactionId String @unique
  transaction   EscrowTransaction @relation(fields: [transactionId], references: [id])

  raisedById String
  raisedBy   User   @relation("RaisedDisputes", fields: [raisedById], references: [id])

  category    DisputeCategory
  description String          @db.Text
  status      DisputeStatus   @default(OPEN)
  outcome     DisputeOutcome?

  tenantEvidence   Json?
  landlordEvidence Json?

  resolution  String?   @db.Text
  resolvedAt  DateTime?
  refundAmount BigInt?

  evidenceDeadline    DateTime?
  mediationDeadline   DateTime?
  adjudicationDeadline DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("disputes")
}

model Conversation {
  id          String    @id @default(cuid())
  listingId   String
  listing     Listing   @relation(fields: [listingId], references: [id])

  // Always exactly 2 participants: tenant + landlord/agent
  tenantId    String
  tenant      User      @relation("TenantConversations", fields: [tenantId], references: [id])
  ownerId     String    // landlord or agent
  owner       User      @relation("OwnerConversations", fields: [ownerId], references: [id])

  messages    Message[]

  // Last message preview (denormalised for list view performance)
  lastMessageAt   DateTime?
  lastMessageText String?   @db.VarChar(200)

  // Unread counts
  tenantUnread  Int @default(0)
  ownerUnread   Int @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([listingId, tenantId, ownerId])
  @@index([tenantId])
  @@index([ownerId])
  @@map("conversations")
}

enum MessageType {
  TEXT
  IMAGE
  PDF
  SYSTEM  // automated platform messages
}

model Message {
  id              String          @id @default(cuid())
  conversationId  String
  conversation    Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId        String
  sender          User            @relation("SentMessages", fields: [senderId], references: [id])

  type            MessageType     @default(TEXT)
  content         String          @db.Text
  mediaUrl        String?         // for IMAGE or PDF types

  isRead          Boolean         @default(false)
  readAt          DateTime?

  // System message metadata
  systemEventType String?         // e.g. "VIEWING_CONFIRMED", "ESCROW_FUNDED"

  createdAt   DateTime @default(now())

  @@index([conversationId])
  @@index([senderId])
  @@map("messages")
}
