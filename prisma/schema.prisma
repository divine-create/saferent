generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  TENANT
  LANDLORD
  AGENT
  ADMIN
}

enum VerificationStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  FAILED
}

enum IdDocumentType {
  NATIONAL_ID
  VOTERS_CARD
  PASSPORT
  DRIVERS_LICENCE
}

enum BadgeTier {
  NONE
  ID_VERIFIED
  PROPERTY_VERIFIED
  CERTIFIED
}

enum AgentPlan {
  NONE
  BASIC
  PRO
  ENTERPRISE
}

enum OtpType {
  PHONE_VERIFY
  EMAIL_VERIFY
  LOGIN
  SENSITIVE_ACTION
}

model User {
  id                     String             @id @default(cuid())
  email                  String?            @unique
  phone                  String?            @unique
  passwordHash           String?
  role                   UserRole           @default(TENANT)
  isEmailVerified        Boolean            @default(false)
  isPhoneVerified        Boolean            @default(false)
  bvnHash                String?
  bvnVerificationStatus  VerificationStatus @default(NOT_SUBMITTED)
  ninHash                String?
  ninVerificationStatus  VerificationStatus @default(NOT_SUBMITTED)
  idDocumentStatus       VerificationStatus @default(NOT_SUBMITTED)
  trustScore             Int                @default(0)
  firstName              String?
  lastName               String?
  dateOfBirth            DateTime?
  profilePhoto           String?
  isActive               Boolean            @default(true)
  isBanned               Boolean            @default(false)
  onboardingComplete     Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  accounts              Account[]
  sessions              Session[]
  profile               UserProfile?
  landlordVerification  LandlordVerification?
  agentProfile          AgentProfile?

  @@map("users")
}

model UserProfile {
  id                    String          @id @default(cuid())
  userId                String          @unique
  employmentStatus      String?
  employerName          String?
  bankStatementUploaded Boolean         @default(false)
  payslipUploaded       Boolean         @default(false)
  selfieUrl             String?
  governmentIdUrl       String?
  governmentIdType      IdDocumentType?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model LandlordVerification {
  id                    String    @id @default(cuid())
  userId                String    @unique
  badgeTier             BadgeTier @default(NONE)
  titleDocumentUrl      String?
  utilityBillUrl        String?
  completedTransactions Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("landlord_verifications")
}

model AgentProfile {
  id                        String             @id @default(cuid())
  userId                    String             @unique
  businessName              String?
  cacNumber                 String?
  cacVerificationStatus     VerificationStatus @default(NOT_SUBMITTED)
  lasreraNumber             String?
  lasreraVerificationStatus VerificationStatus @default(NOT_SUBMITTED)
  subscriptionPlan          AgentPlan          @default(NONE)
  subscriptionExpiresAt     DateTime?
  bio                       String?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("agent_profiles")
}

model OtpCode {
  id         String   @id @default(cuid())
  identifier String
  code       String
  type       OtpType
  expiresAt  DateTime
  used       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([identifier, type])
  @@map("otp_codes")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
